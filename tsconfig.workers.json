{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // core and wire as a Cloudflare Worker consumer compiles them: ES2023 plus the real
    // Workers runtime types, no DOM. Complements tsconfig.nodom.json (minimal host globals).
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["packages/core/src", "packages/wire/src"],
  "exclude": ["packages/*/src/**/*.test.ts", "packages/*/src/**/*.test-util.ts"]
}
