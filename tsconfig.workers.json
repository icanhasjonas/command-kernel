{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // core and wire as a Cloudflare Worker consumer compiles them: ES2023 plus the real
    // Workers runtime types, no DOM. Complements tsconfig.nodom.json (minimal host globals).
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  // plus the demo's own Worker, the first real consumer of both on the Workers runtime
  "include": [
    "packages/core/src",
    "packages/wire/src",
    "examples/playground/worker",
    "examples/playground/src/wire/spec.ts"
  ],
  "exclude": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test-util.ts",
    "examples/playground/worker/**/*.test.ts"
  ]
}
